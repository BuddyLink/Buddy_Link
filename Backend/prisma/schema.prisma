// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User{
	id                Int @id @default(autoincrement())
	name	          String
    surname	          String
	email		      String  @unique
	password	      String
    classification	  String
    major 	          String
	profilePicture 	  String?
	preferredContact  String?
    phone 	          String
	walkCount 	      Int  @default (0)
    buddyRequests     BuddyRequest[] @relation("RequesterRequests")
	createdAt		  DateTime @default (now())
	updatedAt		  DateTime @updatedAt
	passwordConfirmation String @default("")
	match 			  Match[] @relation("Match")
	token 			  Token[] @relation("Token")
	codeInput 		  CodeInput[] @relation("CodeInput")
	status 			  String @default("INACTIVE")
}
model BuddyRequest {
	id 	              Int @id @default(autoincrement())
	requesterId       Int
    requester         User  @relation("RequesterRequests", fields: [requesterId], references:[id])
	date			  DateTime
	time 	          DateTime
	destination       Location @relation("RequestDestination", fields:[destinationId], references:[id])
	destinationId     Int
	meetingPoint	  Location @relation("RequestMeeting", fields:[meetingPointId], references:[id])
	meetingPointId    Int
	status 	          RequestStatus @default(PENDING)
	createdAt         DateTime @default(now())
}

model BuddyPair{
	id  	           Int @id @default(autoincrement())
	name			   String
	surname			   String
	major              String
	classification     String
	walkCount          Int
	profilePic         String
	preferredContact   String
	email              String?
	phone              String?
	date			   DateTime
	time               DateTime
	destinationPair    Location @relation("Destination", fields:[destinationPairId], references:[id])
	destinationPairId  Int
	location		   Location @relation("Location", fields:[locationId], references:[id])
	locationId         Int
	confirmed          Boolean @default(false)
	confirmedAt        DateTime?
	createdAt          DateTime @default(now())
	match 			   Match[] @relation("BuddyMatch")
	status 			   String @default("ACTIVE")
}
enum RequestStatus{
	PENDING
	PAIRED
	DECLINED
}

model Location{
	id 		Int @id
	name    String
	latitude Float
	longitude Float
	destinationRequests BuddyRequest[] @relation("RequestDestination")
	meetingPointRequests BuddyRequest[] @relation("RequestMeeting")
	destinationRequestsPair BuddyPair[] @relation("Destination")
	locationRequestsPair BuddyPair[] @relation("Location")
}

model Match{
	id         Int @id @default(autoincrement())
	userId     Int
	user       User  @relation("Match", fields: [userId], references:[id])
	buddyId    Int
	buddyPair  BuddyPair  @relation("BuddyMatch", fields: [buddyId], references:[id])
	createdAt  DateTime @default(now())
}

model Token{
	id	       Int @id @default(autoincrement())
	fcmToken   String
	userId     Int
	user       User  @relation("Token", fields: [userId], references:[id])
	@@unique([fcmToken, userId])
}

model CodeInput{
	id	       Int @id @default(autoincrement())
	codeInput  String
	userId     Int
	user       User  @relation("CodeInput", fields: [userId], references:[id])
}
